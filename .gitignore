build
# Variant builds from -DXIVO_OUTPUT_SUFFIX, which puts a differently-sized EKF
# state beside the default build (see EKF_MAX_FEATURES in CMakeLists.txt).
build_*
bin_*
lib_*
.idea
*.pyc
estimator/*json
tmp.*
test_cfg/
bin/
lib/
src/src/
src/Makefile
thirdparty
back_results/

.vscode/
doc/html/
doc/latex/

*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.pdf
*.synctex.gz

tumvi_*
# ... but the tumvi configs are source, not output. Without this, generated
# configs like cfg/tumvi_stereo.json are silently dropped from commits.
!cfg/tumvi_*.json
