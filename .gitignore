build
# Variant builds from -DXIVO_OUTPUT_SUFFIX, which puts a differently-sized EKF
# state beside the default build (see EKF_MAX_FEATURES in CMakeLists.txt).
build_*
bin_*
lib_*
# Instrumented builds from scripts/mem/build.sh, which puts a sanitized tree
# beside the plain one via -DXIVO_OUTPUT_DIR.
build-*/
out-*/
.idea
*.pyc
estimator/*json
tmp.*
test_cfg/
bin/
lib/
src/src/
src/Makefile
thirdparty
back_results/

.vscode/
doc/html/
doc/latex/

*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.pdf
*.synctex.gz

tumvi_*
# ... but the tumvi configs are source, not output. Without this, generated
# configs like cfg/tumvi_stereo.json are silently dropped from commits.
!cfg/tumvi_*.json

# generated by the ensemble harnesses -- one config per member
cfg/_ensemble/
cfg/_ens/
# scratch variants from the OOS knob sweeps; the tuned results are shipped as
# cfg/tumvi_{stereo,mono_ctl}_oos.json
cfg/_oos/
# Scratch configs written by experiments/openvins/sweep_xivo.sh, one per
# tuning variant. The measured outcomes live in notes-euroc/, and the winning
# values are baked into scripts/make_euroc_cfg.py; these are just the temporary
# patched copies the sweep hands to pyxivo.
cfg/tune_*.json
