  "min_inliers": 5,
  "MH_thresh": 5.991,
  "MH_adjust_factor": 1.15,
  "1pt_RANSAC_thresh": 1.5,
  "1pt_RANSAC_prob": 0.95,
  "1pt_RANSAC_Chi2": 5.89,
  "num_gauge_xy_features": 3,
  "collinear_cross_prod_thresh": 0.001,
  "tracker_cfg": {
    // Was false here (and in 23 other configs) while the key was dead: the
    // tracker always seeded KLT from the EKF's predicted measurement regardless.
    // The auto-bugfix merge makes the key live, so the value that preserves the
    // behaviour this config was tuned against -- and that produced the numbers
    // in RESULTS_STEREO.md -- is true. It is also load-bearing: honoring false
    // on TUM-VI mono diverges room4 (ATE 0.10 -> 1.04).
    "use_prediction": true,
    "mask_size": 15,
    "margin": 8,
    // 3x the upstream 45/60. This is the *other* half of the capacity change:
    // the EKF cannot hold more features than the tracker supplies, which is why
    // an EKF_MAX_FEATURES of 60 and of 90 were bit-identical while this stayed at
    // 60. Raising both together is what takes mean ATE from 0.076 to 0.048 m;
    // going further (240 tracked / 120 in state) gains 0.001, inside the noise.
    "num_features_min": 135,
    "num_features_max": 180,
    "max_pixel_displacement": 64,
    "normalize": false,
    "match_dropped_tracks": false,
    "do_outlier_rejection": false,
    "KLT": {
      "win_size": 15,
      // 4, not the historical 5: the temporal search's cost is in the LK solve,
      // which iterates at every level (2.365 -> 2.041 ms per 180 points), while
      // the pyramid itself is free either way. +3.5% mono, +2% stereo, and the
      // mono ensemble moved 0.0566 -> 0.0555 m ATE, i.e. it costs no accuracy.
      "max_level": 4,
      "max_iter": 30,
      "eps": 0.01
    },
    "outlier_rejection": {
      "method": "LMEDS",
      "RANSAC_reproj_thresh": 3.0,
      "RANSAC_max_iters": 2000,
      "confidence": 0.995
    },
    "extract_descriptor": false,
    "descriptor_distance_thresh": -1,
    "descriptor": "BRIEF",
    "differential": false,
    "tracker_type": "LK",
    "detector": "FAST",
    "FAST": {
      "threshold": 20,
      "nonmaxSuppression": true
    },
    "BRISK": {
      "thresh": 25,
      "octaves": 3,
      "patternScale": 1.0
    },
    "ORB": {
      "nfeatures": 500,
      "scaleFactor": 1.2,
      "nlevels": 4,
      "edgeThreshold": 31,
      "firstLevel": 0,
      "WTA_K": 2,
      "patchSize": 31,
      "fastThreshold": 20
    },
    "AGAST": {
      "threshold": 10,
      "nonmaxSuppression": true
    },
    "GFTT": {
      "maxCorners": 1000,
      "qualityLevel": 0.01,
      "minDistance": 1.0,
      "blockSize": 3,
      "useHarrisDetector": false,
      "k": 0.04
    },
    "SIFT": {
      "nfeatures": 0,
      "nOctaveLayers": 2,
      "contrastThreshold": 0.0,
      "edgeThreshold": 500.0,
      "sigma": 1.6
    },
    "SURF": {
      "hessianThreshold": 100,
      "nOctaves": 1,
      "nOctaveLayers": 2,
      "extended": false,
      "upright": false
    },
    "BRIEF": {
      "bytes": 32,
      "use_orientation": false
    },
    "FREAK": {
      "orientationNormalized": true,
      "scaleNormalized": true,
      "patternScale": 22.0,
      "nOctaves": 4
    },
    "stereo_matching": {
      "comment": "gates on the left->right KLT match; see notes-stereo/m3",
      // The left->right match, restructured; see notes-frontfast/m3-stereo-matching.md.
      // `back_track: false` drops the right->left KLT solve and lets the epipolar
      // residual carry those rejections (epipolar 12576 -> 51617, circular 34942 ->
      // 7476, matched 88.3% -> 85.8%). `max_level: 2` shortens the search, which is
      // safe because the disparity is bounded by a 10 cm baseline, unlike the
      // temporal search's rotation. Together: `track` 9.91 -> 6.81 ms, stereo 41.0
      // -> 53.6 FPS over six rooms, stereo ATE 0.0472 -> 0.0488 m against a 0.0677
      // floor.
      "back_track": false,
      "max_level": 2,
      "epipolar_thresh": 0.005,
      "circular_thresh": 1.0,
      "min_disparity": 1.0,
      "max_disparity": 150.0
    }
  },
