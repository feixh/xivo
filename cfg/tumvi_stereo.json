  "max_subfilter_outlier": 0.01,
  "strict_criteria_timesteps": 5,
  "comparison_score_type": "DepthUncertainty",
  // 0.75 px, halved from the monocular 1.5. Two right-image observations per
  // feature make the update better conditioned, so trusting the pixels more pays
  // off here where it did not before: six-room mean ATE 0.101 -> 0.084 m at
  // otherwise-fixed settings.
  "visual_meas_std": 0.75,
  "outlier_thresh": 1.1,
  "oos_meas_std": 3.5,
  "max_depth": 5.0,
  "min_depth": 0.05,
  "adaptive_initial_depth": {
