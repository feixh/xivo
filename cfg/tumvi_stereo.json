{
  "simulation": false,
  "print_timing": false,
  "use_canvas": true,
  "use_debug_view": false,
  "async_run": false,
  // Decode grayscale PNGs with src/pngfast.cpp (libdeflate + a fused unfilter and
  // 16->8 strip) instead of libpng+zlib: 2.81 -> 1.42 ms per 512x512 16-bit
  // image, byte-identical output. unitTests_pngfast pins that against
  // cv::imdecode, and the XIVO_DUMP_PRECISE trajectories match under cmp, so
  // this is +9.3% FPS in both modes at exactly zero accuracy cost. Anything the
  // fast path cannot reproduce falls back to cv::imdecode. See
  // notes-frontfast/m2-png-decode.md.
  "fast_png_decode": true,
  "print_bias_info": true,
  "draw_OOS": true,
  "integration_method": "PrinceDormand",
  "use_OOS": false,
  "use_depth_opt": false,
  "use_MH_gating": true,
  "use_1pt_RANSAC": false,
  "use_compression": false,
  "triangulate_pre_subfilter": true,
  "compression_trigger_ratio": 1.5,
  "max_group_lifetime": 60,
  "remove_outlier_counter": 10,
  "OOS_update_min_observations": 5,
  "feature_owner_change_cov_factor": 1.5,
  "group_degrees_fixed": 4,
  "PrinceDormand": {
    "control_stepsize": false,
    "tolerance": 1e-15,
    "attempts": 12,
    "min_scale_factor": 0.125,
    "max_scale_factor": 4.0,
    "stepsize": 0.002
  },
  "RK4": {
    "stepsize": 0.002
  },
  // The EKF capacity this config was tuned for. Capacity is compile-time
  // (EKF_MAX_FEATURES/EKF_MAX_GROUPS in the top-level CMakeLists.txt, defaulted
  // to these values), so a config and a binary can disagree with no symptom
  // other than worse numbers. CheckMemoryPools in src/factory.cpp refuses to
  // start when the binary is smaller than this.
  "require_ekf_max_features": 90,
  "require_ekf_max_groups": 45,

  // Object pools, not EKF capacity -- raising these alone changes nothing (the
  // EKF cap is EKF_MAX_FEATURES/EKF_MAX_GROUPS at build time, 90/45 here). They
  // are a fixed pre-allocation whose exhaustion is a LOG(FATAL) partway through
  // a run, so CheckMemoryPools in src/factory.cpp refuses anything below the
  // tracker cap and advises 2x it. Measured peak over room1-room6 is about 1.7x
  // the tracker cap; 800 is 4.4x, which is real headroom for pennies of memory.
  "memory": {
    "max_features": 800,
    "max_groups": 300
  },
